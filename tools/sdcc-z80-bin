#!/bin/sh
set -eu

usage() {
    printf 'usage: %s [-o output.bin] [--stack 0x7700] [--asm-out output.asm] input.c\n' "$0" >&2
}

stack=0x7700
output=
asm_out=
input=

while [ "$#" -gt 0 ]; do
    case "$1" in
        -o)
            [ "$#" -ge 2 ] || { usage; exit 1; }
            output=$2
            shift 2
            ;;
        --stack)
            [ "$#" -ge 2 ] || { usage; exit 1; }
            stack=$2
            shift 2
            ;;
        --stack=*)
            stack=${1#--stack=}
            shift
            ;;
        --asm-out)
            [ "$#" -ge 2 ] || { usage; exit 1; }
            asm_out=$2
            shift 2
            ;;
        --asm-out=*)
            asm_out=${1#--asm-out=}
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            usage
            exit 1
            ;;
        *)
            if [ -n "$input" ]; then
                usage
                exit 1
            fi
            input=$1
            shift
            ;;
    esac
done

if [ -z "$input" ]; then
    usage
    exit 1
fi

if [ -z "$output" ]; then
    case "$input" in
        *.*) output=${input%.*}.bin ;;
        *) output=$input.bin ;;
    esac
fi

title=${input##*/}
case "$title" in
    *.*) title=${title%.*} ;;
esac
title_asm=$(printf '%s' "$title" | sed 's/[\\"]/\\&/g')

if command -v sdcc-sdcc >/dev/null 2>&1; then
    sdcc_bin=sdcc-sdcc
elif command -v sdcc >/dev/null 2>&1; then
    sdcc_bin=sdcc
else
    printf 'sdcc-z80-bin: sdcc-sdcc or sdcc is required on PATH\n' >&2
    exit 1
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$script_dir/.." && pwd)
asmr=$root/z80-asm
if [ ! -x "$asmr" ]; then
    printf 'sdcc-z80-bin: %s is missing or not executable; run make first\n' "$asmr" >&2
    exit 1
fi

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/sdcc-z80-bin.XXXXXX")
trap 'rm -rf "$tmpdir"' EXIT HUP INT TERM

sdcc_asm=$tmpdir/sdcc.asm
combined_asm=$tmpdir/combined.asm

"$sdcc_bin" -mz80 -S "$input" -o "$sdcc_asm"

{
    printf '; generated by sdcc-z80-bin\n'
    printf '    JR __sdcc_z80_bin_start\n'
    printf '    DB "%s",0\n' "$title_asm"
    printf '__sdcc_z80_bin_start:\n'
    printf '    LD SP,#%s\n' "$stack"
    printf '    CALL _main\n'
    printf '__sdcc_z80_bin_halt:\n'
    printf '    JR __sdcc_z80_bin_halt\n'
    printf '\n'
    cat "$sdcc_asm"
} >"$combined_asm"

if [ -n "$asm_out" ]; then
    cp "$combined_asm" "$asm_out"
fi

"$asmr" -o "$output" "$combined_asm"
